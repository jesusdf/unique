%% Functional-equivalence test schema — minimal invoicing domain.
%% Engine-agnostic. LOCKED for Phase 1 (see ../coverage-matrix.md).
%% This diagram is the human-readable view of the schema; the authoritative DDL
%% is schema/tsql.sql (authored next). Regenerate this from that DDL once it
%% exists so the two cannot drift.
classDiagram
    class customer {
        +int id PK (identity, start 1)
        string name
        string email UNIQUE
        text notes  %% from VARCHAR(MAX), NULLable
    }
    class product {
        +int id PK (identity, start 1)
        string name
        decimal~10,2~ unit_price
        bool is_active  %% Scenario B: toggled by a searched UPDATE
    }
    class invoice {
        +int id PK (identity, start 1)
        +int customer_id FK
        date issued_on
        date due_on  %% Scenario B: issued_on + 30 days (date arithmetic)
        datetime created_at  %% clock-stamped; presence-asserted only
        datetime updated_at  %% Scenario B: set by trg_invoice_touch on UPDATE
        bool is_paid  %% DEFAULT false; set true via payment path
        decimal~12,2~ total  %% = SUM(line_total) + fn_tax(...) ; maintained by trigger
    }
    class invoice_line {
        +int id PK (identity, start 1)
        +int invoice_id FK
        +int product_id FK
        int qty  %% CHECK qty > 0
        decimal~10,2~ unit_price
        decimal~10,2~ line_total  %% qty * unit_price
    }
    class payment {
        +int id PK (identity, start 1)
        +int invoice_id FK
        date paid_on
        decimal~12,2~ amount
    }

    customer "1" --> "*" invoice : places
    invoice "1" --> "*" invoice_line : contains
    product "1" --> "*" invoice_line : referenced by
    invoice "1" --> "*" payment : settled by

    %% Behavioral objects (not class-diagram nodes; listed for reference):
    %%   view     v_invoice_totals : SUM(line_total) per invoice (net, pre-tax)
    %%   view     v_overdue_invoices: Scenario B; days_overdue via fn_days_between
    %%   function fn_tax           : scalar, returns net * 0.10 (10%), exact at scale 2
    %%   function fn_days_between  : Scenario B; engine-neutral DATEDIFF wrapper
    %%   trigger  trg_line_total   : AFTER INSERT/UPDATE ON invoice_line
    %%                               -> invoice.total = SUM(line_total) + fn_tax(SUM(line_total))
    %%   trigger  trg_invoice_touch: Scenario B; BEFORE UPDATE ON invoice -> updated_at
    %%   proc     create_invoice   : insert header + lines, return new invoice id
    %%                               (DEFAULT applies: is_paid starts false)
    %%   proc     bulk_reprice     : Scenario B; UPDATE-with-JOIN product -> invoice_line
